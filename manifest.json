{
  "schemaVersion": 1,
  "id": "harris.daily-bread",
  "name": "Daily Bread",
  "version": "0.1.3",
  "author": "Harris Kenny",
  "license": "MIT",
  "description": "Give us this day the verse. Pause. Unofficial Midvash Bible verse of the day; not affiliated.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "keywords": [
    "daily bread",
    "bible",
    "bible verse",
    "verse of the day",
    "votd",
    "scripture",
    "daily verse",
    "kjv",
    "niv",
    "esv",
    "web bible",
    "world english bible",
    "midvash",
    "devotion",
    "quiet time",
    "psalm",
    "gospel",
    "our father",
    "lords prayer",
    "lord's prayer",
    "christian",
    "faith",
    "verse"
  ],
  "barWidget": {
    "displayName": "Daily Bread",
    "description": "Verse of the day. A quiet pause. Midvash public VOTD. Unofficial; not affiliated with Midvash or any Bible publisher.",
    "category": "Widgets",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "version": "web",
      "language": "en"
    },
    "schema": [
      {
        "key": "version",
        "type": "enum",
        "label": "Bible version",
        "description": "English translation slug for Midvash VOTD. Default web (World English Bible, public domain).",
        "options": [
          "web",
          "kjv",
          "esv",
          "niv",
          "nkjv",
          "nlt",
          "msg"
        ],
        "defaultValue": "web"
      },
      {
        "key": "language",
        "type": "enum",
        "label": "Language",
        "description": "API language code. MVP UI is English-only; leave en.",
        "options": [
          "en"
        ],
        "defaultValue": "en"
      }
    ],
    "aliases": [
      "daily bread",
      "bible",
      "bible verse",
      "verse of the day",
      "votd",
      "scripture",
      "daily verse",
      "kjv",
      "niv",
      "esv",
      "web bible",
      "midvash",
      "devotion",
      "quiet time",
      "christian",
      "faith"
    ]
  }
}
